        },
        {
          "id": "ports",
          "type": "single",
          "text_en": "Are all ports (USB, HDMI, jack, charging) working?",
          "options": [
            { "id": "fine", "label_en": "Yes, all working", "deduction": null },
            { "id": "some_dead", "label_en": "Some ports don't work", "deduction": { "type": "pct", "value": 8 } }
          ]
        },
        {
          "id": "storage_health",
          "type": "single",
          "text_en": "Any storage warnings or unusual slowness?",
          "options": [
            { "id": "fine", "label_en": "No, runs normally", "deduction": null },
            { "id": "issues", "label_en": "Disk warnings / very slow / clicking sounds", "deduction": { "type": "pct", "value": 10 } }
          ]
        },
        {
          "id": "os_license",
          "type": "single",
          "text_en": "Is the operating system genuine and activated?",
          "options": [
            { "id": "genuine", "label_en": "Yes, activated", "deduction": null },
            { "id": "not_activated", "label_en": "No / not sure", "deduction": { "type": "flat", "value": 1500 } }
          ]
        }
      ]
    },
    {
      "id": "extras",
      "title_en": "Charger & bill",
      "questions": [
        {
          "id": "charger",
          "type": "single",
          "text_en": "Do you have the charger?",
          "options": [
            { "id": "original", "label_en": "Yes, the original charger", "deduction": null },
            { "id": "third_party", "label_en": "Only a third-party charger", "deduction": { "type": "flat", "value": 500 } },
            { "id": "none", "label_en": "No charger", "deduction": { "type": "flat", "value": 1500 } }
          ]
        },
        {
          "id": "bill",
          "type": "single",
          "text_en": "Do you have the purchase bill?",
          "options": [
            { "id": "bill_warranty", "label_en": "Yes, and warranty is still active", "deduction": { "type": "pct", "value": -3 } },
            { "id": "bill_only", "label_en": "Yes, bill only", "deduction": { "type": "flat", "value": -300 } },
            { "id": "none", "label_en": "No bill", "deduction": null }
          ]
        }
      ]
    }
