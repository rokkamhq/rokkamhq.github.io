    {
      "id": "internals",
      "title_en": "Battery, ports & storage",
      "questions": [
        {
          "id": "battery",
          "type": "single",
          "text_en": "How is the battery?",
          "options": [
            { "id": "good", "label_en": "Holds a good charge (2+ hours of work)", "deduction": null },
            { "id": "weak", "label_en": "Drains fast / under an hour", "deduction": { "type": "pct", "value": 8 } },
            { "id": "dead", "label_en": "Only works when plugged in", "deduction": { "type": "pct", "value": 15 } }
