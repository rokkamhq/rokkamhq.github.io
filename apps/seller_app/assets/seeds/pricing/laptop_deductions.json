{
  "schema_version": "1.0",
  "category": "laptop",
  "status": "DEMO values — laptop deduction matrix v1. Values reviewed in admin pricing pass before launch.",
  "sign_convention": "deduction.value > 0 lowers the price; value < 0 is a bonus. type: pct = % of base price, flat = INR.",
  "sections": [
    {
      "id": "locks",
      "title_en": "Ownership check",
      "questions": [
        {
          "id": "account_lock",
          "type": "single",
          "text_en": "Can you sign out of all accounts and remove passwords (iCloud / Microsoft / BIOS)?",
          "options": [
            { "id": "yes", "label_en": "Yes, I can sign out of everything", "deduction": null },
            { "id": "no", "label_en": "No, it stays locked to an account I can't access", "deduction": null, "kills_deal": true }
          ]
        }
      ]
    },
    {
      "id": "power",
      "title_en": "Power & boot",
      "questions": [
        {
          "id": "boots",
          "type": "single",
          "text_en": "Does the laptop switch on and boot normally?",
          "options": [
            { "id": "normal", "label_en": "Yes, boots and runs fine", "deduction": null },
            { "id": "unstable", "label_en": "Boots, but shuts down / hangs randomly", "deduction": { "type": "pct", "value": 20 } },
            { "id": "dead", "label_en": "Does not switch on", "deduction": { "type": "pct", "value": 60 } }
          ]
        }
      ]
    },
    {
      "id": "display",
      "title_en": "Display",
      "questions": [
        {
          "id": "screen",
          "type": "single",
          "text_en": "How is the screen?",
          "options": [
            { "id": "flawless", "label_en": "Flawless — no marks", "deduction": null },
            { "id": "minor", "label_en": "Minor scratches, all visible fine", "deduction": { "type": "pct", "value": 4 } },
            { "id": "spots_lines", "label_en": "Spots, patches or lines", "deduction": { "type": "pct", "value": 18 } },
            { "id": "cracked", "label_en": "Cracked or broken panel", "deduction": { "type": "pct", "value": 30 } }
          ]
        }
      ]
    },
    {
      "id": "input",
      "title_en": "Keyboard & trackpad",
      "questions": [
        {
          "id": "keyboard",
          "type": "single",
          "text_en": "Keyboard and trackpad working fully?",
          "options": [
            { "id": "fine", "label_en": "Yes, everything works", "deduction": null },
            { "id": "some_keys", "label_en": "Some keys or gestures don't work", "deduction": { "type": "pct", "value": 10 } },
            { "id": "major", "label_en": "Keyboard or trackpad mostly dead", "deduction": { "type": "pct", "value": 18 } }
          ]
        }
      ]
    },
    {
      "id": "body",
      "title_en": "Body & hinge",
      "questions": [
        {
          "id": "body_condition",
          "type": "single",
          "text_en": "How is the body and hinge?",
          "options": [
            { "id": "like_new", "label_en": "Like new", "deduction": null },
            { "id": "scratches", "label_en": "Light scratches only", "deduction": { "type": "pct", "value": 4 } },
            { "id": "dents", "label_en": "Dents or cracked panels", "deduction": { "type": "pct", "value": 10 } },
            { "id": "hinge", "label_en": "Hinge loose or broken", "deduction": { "type": "pct", "value": 18 } }
          ]
        }
