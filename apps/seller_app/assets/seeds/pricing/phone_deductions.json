            { "id": "original_india", "label_en": "Yes, bought in India", "deduction": null },
            { "id": "original_import", "label_en": "Yes, but bought abroad / imported", "deduction": null, "note_en": "Our agent will check the region lock at pickup." },
            { "id": "clone", "label_en": "It's a copy / first-copy phone", "deduction": null, "kills_deal": true }
          ]
        }
      ]
    },
    {
